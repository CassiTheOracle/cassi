#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer FieldWords { uint words[]; };
layout(push_constant) uniform AddParameters { uint offset; uint count; uint value; } parameters;
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < parameters.count) {
        words[parameters.offset + index] += parameters.value;
    }
}
