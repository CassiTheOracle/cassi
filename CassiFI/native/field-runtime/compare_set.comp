#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) buffer FieldWords { uint words[]; };
layout(set = 0, binding = 1) buffer CompareStatus { uint stale; };
layout(push_constant) uniform CompareParameters { uint destination; uint expected; uint value; } parameters;
void main() {
    uint actual = words[parameters.destination];
    if (actual != parameters.expected) {
        atomicOr(stale, 1u);
    } else {
        words[parameters.destination] = parameters.value;
    }
}
