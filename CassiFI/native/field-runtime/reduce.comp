#version 450
// Exact u64 word-range reduction: each work group grid-strides over the
// requested word range accumulating a two-limb (low, high) u64 value, reduces
// the group tile with shared memory, and the group leader stores one uvec2
// partial. The CPU folds the partials and checks them against the exact oracle.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer FieldWords { uint words[]; };
layout(set = 0, binding = 1) buffer ReducePartials { uvec2 partials[]; };
layout(push_constant) uniform ReduceParameters { uint offset; uint count; } parameters;

uvec2 add64(uvec2 left, uvec2 right) {
    uint low = left.x + right.x;
    uint high = left.y + right.y + (low < left.x ? 1u : 0u);
    return uvec2(low, high);
}

shared uvec2 tile[256];

void main() {
    uvec2 accumulator = uvec2(0u, 0u);
    const uint stride = gl_NumWorkGroups.x * 256u;
    for (uint index = gl_GlobalInvocationID.x; index < parameters.count; index += stride) {
        accumulator = add64(accumulator, uvec2(words[parameters.offset + index], 0u));
    }
    tile[gl_LocalInvocationID.x] = accumulator;
    barrier();
    for (uint step = 128u; step >= 1u; step >>= 1u) {
        if (gl_LocalInvocationID.x < step) {
            tile[gl_LocalInvocationID.x] = add64(tile[gl_LocalInvocationID.x], tile[gl_LocalInvocationID.x + step]);
        }
        barrier();
    }
    if (gl_LocalInvocationID.x == 0u) {
        partials[gl_WorkGroupID.x] = tile[0];
    }
}
