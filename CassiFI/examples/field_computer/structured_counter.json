{
  "schema": "cassifi.structured-field-program.v1",
  "constants": {
    "STEP": 1,
    "TARGET": 5
  },
  "functions": {
    "increment": [
      {"op": "add_acc", "value": "STEP"}
    ]
  },
  "main": [
    {
      "op": "with_var",
      "name": "target",
      "value": "TARGET",
      "body": [
        {"op": "set_acc", "value": 0},
        {
          "op": "while_acc",
          "condition": {"not_equals": "TARGET"},
          "body": [
            {"op": "call", "function": "increment"}
          ]
        },
        {"op": "push_acc", "stack": "left"},
        {"op": "load_var", "name": "target"}
      ]
    }
  ],
  "left": [],
  "right": [],
  "scratch_stack": "left"
}
