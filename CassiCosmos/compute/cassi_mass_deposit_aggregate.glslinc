// Optional exact workgroup aggregation. The 1024-slot table is only a
// reduction cache: a full probe falls back to the original global atomics,
// so no contribution is ever dropped. Shared digit sums cannot overflow:
// one 256-lane group emits at most 6912 contributions per cell.
const uint AGG_SLOTS = 1024u;
const uint AGG_MASK = AGG_SLOTS - 1u;
const uint AGG_EMPTY = 0xffffffffu;
shared uint agg_key[1024];
shared uvec4 agg_digits[1024];

bool aggregate_digit(uint cell, uint digit, uint value) {
    uint slot = (cell * 2654435761u) & AGG_MASK;
    for (uint probe = 0u; probe < AGG_SLOTS; probe++) {
        uint key = atomicCompSwap(agg_key[slot], AGG_EMPTY, cell);
        if (key == AGG_EMPTY || key == cell) {
            atomicAdd(agg_digits[slot][digit], value);
            return true;
        }
        slot = (slot + 1u) & AGG_MASK;
    }
    return false;
}

// ── Mode 2: exact workgroup aggregation with complete fallback ───────
// This mode is opt-in. Every lane reaches both barriers; only the reduction
// cache is shared between lanes, while the fixed-point destination remains
// the canonical global accumulator.
void aggregate_main() {
    uint i = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    int Np = int(pc.particle_N);
    for (uint slot = lane; slot < AGG_SLOTS; slot += 256u) {
        agg_key[slot] = AGG_EMPTY;
        agg_digits[slot] = uvec4(0u);
    }
    barrier();

    if (int(i) < Np) {
        vec4 p = pos[i];
        float mass = p.w;
        if (mass > 0.0) {
            int N = int(pc.N_f);
            float hn = float(N) * 0.5;
            vec3 ext = vec3(pc.extent_x, pc.extent_y, pc.extent_z);
            vec3 scale = (ext.x > 0.0) ? (hn / ext) : vec3(hn);
            vec3 gc = (p.xyz + vec3(pc.off_x, pc.off_y, pc.off_z)) * scale + hn;
            int i0 = int(floor(gc.x));
            int j0 = int(floor(gc.y));
            int k0 = int(floor(gc.z));
            float fx = gc.x - float(i0);
            float fy = gc.y - float(j0);
            float fz = gc.z - float(k0);
            i0 = ((i0 % N) + N) % N;
            j0 = ((j0 % N) + N) % N;
            k0 = ((k0 % N) + N) % N;
            float wxm = 0.5 * (0.5 - fx) * (0.5 - fx);
            float wxp = (fx < 0.5) ? 0.5 * (0.5 + fx) * (0.5 + fx) : 0.75 - (1.0 - fx) * (1.0 - fx);
            float wx0 = (fx < 0.5) ? 0.75 - fx * fx : 0.5 * (1.5 - fx) * (1.5 - fx);
            float wym = 0.5 * (0.5 - fy) * (0.5 - fy);
            float wyp = (fy < 0.5) ? 0.5 * (0.5 + fy) * (0.5 + fy) : 0.75 - (1.0 - fy) * (1.0 - fy);
            float wy0 = (fy < 0.5) ? 0.75 - fy * fy : 0.5 * (1.5 - fy) * (1.5 - fy);
            float wzm = 0.5 * (0.5 - fz) * (0.5 - fz);
            float wzp = (fz < 0.5) ? 0.5 * (0.5 + fz) * (0.5 + fz) : 0.75 - (1.0 - fz) * (1.0 - fz);
            float wz0 = (fz < 0.5) ? 0.75 - fz * fz : 0.5 * (1.5 - fz) * (1.5 - fz);
            int im = ((i0 - 1 + N) % N), jm = ((j0 - 1 + N) % N), km = ((k0 - 1 + N) % N);
            int i1 = (i0 + 1) % N, j1 = (j0 + 1) % N, k1 = (k0 + 1) % N;
            int idx[3] = int[](im, i0, i1);
            int jdx[3] = int[](jm, j0, j1);
            int kdx[3] = int[](km, k0, k1);
            float wx[3] = float[](wxm, wx0, wxp);
            float wy[3] = float[](wym, wy0, wyp);
            float wz[3] = float[](wzm, wz0, wzp);
            for (int a = 0; a < 3; a++) {
                for (int b = 0; b < 3; b++) {
                    for (int c = 0; c < 3; c++) {
                        uint id = uint(idx[a] + N * (jdx[b] + N * kdx[c]));
                        float vf = min(round(mass * wx[a] * wy[b] * wz[c] * 16777216.0), 4294967040.0);
                        uint v = uint(vf);
                        if (v != 0u) {
                            uint nd = (uint(findMSB(v)) >> 3) + 1u;
                            for (uint digit = 0u; digit < nd; digit++) {
                                uint value = (v >> (8u * digit)) & 255u;
                                if (!aggregate_digit(id, digit, value)) {
                                    atomicAdd(fix[id][digit], value);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    barrier();
    for (uint slot = lane; slot < AGG_SLOTS; slot += 256u) {
        uint id = agg_key[slot];
        if (id != AGG_EMPTY) {
            uvec4 d = agg_digits[slot];
            atomicAdd(fix[id][0], d.x);
            atomicAdd(fix[id][1], d.y);
            atomicAdd(fix[id][2], d.z);
            atomicAdd(fix[id][3], d.w);
        }
    }
    barrier();
}
