#!/usr/bin/env bash
# CassiCore ACP Server — stdio-based ACP agent for AionUi
#
# Usage: cassi-acp
#
# Environment:
#   CASSICORE_ADMIN_URL   — daemon admin API URL (default: http://127.0.0.1:7433)
#   CASSI_ACP_LOG         — log file path (default: ~/.cassicore/cassi-acp.log)
#   CASSICORE_ADMIN_TOKEN — admin API bearer token (optional)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CASSICORE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ENTRY_POINT="$CASSICORE_ROOT/core/bridge/acp/bin.ts"
TSX="$CASSICORE_ROOT/node_modules/.bin/tsx"

if [[ ! -f "$ENTRY_POINT" ]]; then
  echo "cassi-acp: entry point not found: $ENTRY_POINT" >&2
  echo "Run 'npm install' in $CASSICORE_ROOT first." >&2
  exit 1
fi

if [[ ! -x "$TSX" ]]; then
  echo "cassi-acp: tsx not found at $TSX" >&2
  echo "Run 'npm install' in $CASSICORE_ROOT first." >&2
  exit 1
fi

exec "$TSX" "$ENTRY_POINT" "$@"
