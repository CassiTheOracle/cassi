#!/usr/bin/env bash
# bin/cassicore — CassiCore daemon control script
#
# Usage:
#   cassicore start     Start the daemon in the background
#   cassicore stop      Stop the running daemon
#   cassicore restart   Stop then start the daemon
#   cassicore status    Show daemon status
#   cassicore logs      Tail the daemon log
#   cassicore run       Run the daemon in the foreground (for systemd / debugging)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CASSICORE_DIR="$(dirname "$SCRIPT_DIR")"
CASSICORE_HOME="${CASSICORE_HOME:-$HOME/.cassicore}"
PID_FILE="$CASSICORE_HOME/daemon.pid"
LOG_FILE="$CASSICORE_HOME/daemon.log"
ADMIN_URL="${CASSICORE_URL:-http://127.0.0.1:7433}"
DAEMON_JS="$CASSICORE_DIR/dist/src/index.js"

# ── helpers ────────────────────────────────────────────────────────────────────

get_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
  [[ -n "$pid" ]] || return 1
  echo "$pid"
}

is_running() {
  local pid
  pid="$(get_pid 2>/dev/null)" || return 1
  kill -0 "$pid" 2>/dev/null
}

wait_for_http() {
  local retries=60
  while (( retries-- > 0 )); do
    # Accept any HTTP response (200 OK or 503 degraded) as "daemon is up"
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' "$ADMIN_URL/health" 2>/dev/null)" || code="000"
    if [[ "$code" =~ ^[2345] ]]; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

# Kill any orphaned cassi:super or cassi:daemon processes not tracked by our PID file.
# This handles the case where a supervisor died ungracefully (SIGKILL, OOM) and its
# daemon child became an orphan still holding port 7433.
kill_orphans() {
  local tracked_pid="${1:-}"
  local killed=0

  for pname in "cassi:super" "cassi:daemon"; do
    local pids
    pids="$(pgrep -x "$pname" 2>/dev/null)" || continue
    for pid in $pids; do
      [[ "$pid" == "$tracked_pid" ]] && continue
      echo "[cassicore] Killing orphaned $pname process (PID $pid)" >&2
      kill "$pid" 2>/dev/null || true
      killed=1
    done
  done

  if (( killed )); then
    # Give orphans time to exit
    local retries=10
    while (( retries-- > 0 )); do
      local any_alive=0
      for pname in "cassi:super" "cassi:daemon"; do
        local pids
        pids="$(pgrep -x "$pname" 2>/dev/null)" || continue
        for pid in $pids; do
          [[ "$pid" == "$tracked_pid" ]] && continue
          any_alive=1
        done
      done
      (( any_alive )) || break
      sleep 0.5
    done

    # Force-kill any stragglers
    for pname in "cassi:super" "cassi:daemon"; do
      local pids
      pids="$(pgrep -x "$pname" 2>/dev/null)" || continue
      for pid in $pids; do
        [[ "$pid" == "$tracked_pid" ]] && continue
        echo "[cassicore] Force-killing orphaned $pname (PID $pid)" >&2
        kill -9 "$pid" 2>/dev/null || true
      done
    done
  fi
}

# ── commands ───────────────────────────────────────────────────────────────────

cmd_start() {
  if is_running; then
    local pid; pid="$(get_pid)"
    echo "[cassicore] Daemon already running (PID $pid)" >&2
    return 0
  fi

  if [[ ! -f "$DAEMON_JS" ]]; then
    echo "[cassicore] Daemon not built — running build..." >&2
    (cd "$CASSICORE_DIR" && npm run build) >&2
  fi

  mkdir -p "$CASSICORE_HOME"
  # Clean stale sockets before starting
  rm -f "$CASSICORE_HOME/admin.sock" "$CASSICORE_HOME/bridge.sock"

  # Kill any orphaned cassi:super / cassi:daemon processes from prior runs
  # that might still be holding port 7433
  kill_orphans ""

  echo "[cassicore] Starting daemon..." >&2
  # Start the daemon as a detached background process.
  # The entry point (index.js) runs a supervisor that fork()s the actual
  # daemon as a child process with IPC heartbeat monitoring.
  # We use setsid to create a new process group so it survives shell exit.
  # Set heap limit — prevents OOM crashes from runaway Lumen/team sessions
  export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=6144"
  setsid node "$DAEMON_JS" >>"$LOG_FILE" 2>&1 &
  local bg_pid=$!
  # The setsid'd process may fork — wait briefly and find the supervisor PID
  sleep 0.5
  local real_pid
  real_pid="$(pgrep -f "$(basename "$DAEMON_JS")" | grep -v "$$" | head -1)" || real_pid="$bg_pid"
  echo "$real_pid" >"$PID_FILE"

  local pid; pid="$(get_pid)"
  echo "[cassicore] Daemon started (PID $pid)" >&2
  echo "[cassicore] Waiting for HTTP API..." >&2
  if wait_for_http; then
    echo "[cassicore] Ready — $ADMIN_URL" >&2
  else
    echo "[cassicore] Warning: daemon did not respond within 30s (check $LOG_FILE)" >&2
  fi
}

cmd_stop() {
  if ! is_running; then
    echo "[cassicore] Daemon is not running" >&2
    # Still check for orphans — supervisor may have died but daemon child lives on
    kill_orphans ""
    rm -f "$PID_FILE"
    return 0
  fi

  local pid; pid="$(get_pid)"
  echo "[cassicore] Stopping daemon (PID $pid)..." >&2
  kill "$pid" 2>/dev/null || true

  local retries=30
  while (( retries-- > 0 )); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done

  if kill -0 "$pid" 2>/dev/null; then
    echo "[cassicore] Daemon did not stop gracefully — sending SIGKILL" >&2
    kill -9 "$pid" 2>/dev/null || true
  fi

  # Kill any orphaned cassi:super / cassi:daemon processes from prior runs
  kill_orphans ""

  rm -f "$PID_FILE"
  echo "[cassicore] Stopped." >&2
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start
}

cmd_status() {
  if is_running; then
    local pid; pid="$(get_pid)"
    echo "[cassicore] Running (PID $pid)"

    # Show the daemon child PID too, for full process hierarchy visibility
    local daemon_pid
    daemon_pid="$(pgrep -x 'cassi:daemon' 2>/dev/null | head -1)"
    if [[ -n "$daemon_pid" ]]; then
      echo "[cassicore] Daemon child PID: $daemon_pid"
    fi

    # Try to get version/uptime from health endpoint (accept any HTTP response)
    if curl -s "$ADMIN_URL/health" -o /tmp/cassicore-health.json 2>/dev/null && [[ -s /tmp/cassicore-health.json ]]; then
      local version uptime
      version="$(python3 -c "import json,sys; d=json.load(open('/tmp/cassicore-health.json')); print(d.get('version','?'))" 2>/dev/null || echo '?')"
      uptime="$(python3 -c "import json,sys; d=json.load(open('/tmp/cassicore-health.json')); ms=d.get('uptimeMs',0); print(f\"{ms//3600000}h {(ms%3600000)//60000}m\" if ms else d.get('uptime','?'))" 2>/dev/null || echo '?')"
      echo "[cassicore] Version: $version | Uptime: $uptime | API: $ADMIN_URL"
    else
      echo "[cassicore] API not responding at $ADMIN_URL"
    fi
  else
    echo "[cassicore] Not running"
    [[ -f "$PID_FILE" ]] && echo "[cassicore] (stale PID file: $PID_FILE)"
    return 1
  fi
}

cmd_logs() {
  if [[ ! -f "$LOG_FILE" ]]; then
    echo "[cassicore] No log file at $LOG_FILE" >&2
    return 1
  fi
  tail -f "$LOG_FILE"
}

cmd_llm() {
  # ── cassicore llm — LLM activity inspection suite ──────────────────────────
  #
  #   cassicore llm events [--json] [--filter <str>] [--since <dur>] [--source <prefix>]
  #   cassicore llm stats                                Aggregate metrics per provider
  #   cassicore llm active                               In-flight requests right now
  #
  if ! is_running; then
    echo "[cassicore] Daemon is not running." >&2; return 1
  fi

  local subcmd="${1:-events}"
  shift 2>/dev/null || true

  case "$subcmd" in
    events)  llm_events "$@"  ;;
    stream)  llm_stream "$@"  ;;
    stats)   llm_stats        ;;
    active)  llm_active       ;;
    *)       llm_usage; return 1 ;;
  esac
}

llm_usage() {
  echo "Usage: cassicore llm <subcommand>"
  echo ""
  echo "Subcommands:"
  echo "  events [--json] [--filter <str>] [--since <dur>] [--source <prefix>] [--compact|--full]"
  echo "                                    Replay recent events, then continue live"
  echo "  stream [--json] [--provider <id>] [--source <prefix>] [--all] [--prompt] [--history <n>] [--since <dur>] [--history-only] [--full]"
  echo "                                    Compact LLM output with optional replay history"
  echo "  stats                              Provider metrics snapshot"
  echo "  active                             In-flight requests"
}

# ── llm events — live SSE stream of provider:request_* events ─────────────────

llm_events() {
  local json_mode=false
  local compact_mode=true
  local filter=""
  local since_value=""
  local source_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)   json_mode=true ; shift ;;
      --compact) compact_mode=true ; shift ;;
      --full)   compact_mode=false ; shift ;;
      --filter) filter="$2"    ; shift 2 ;;
      --since)  since_value="$2" ; shift 2 ;;
      --source) source_filter="$2" ; shift 2 ;;
      *)        shift ;;
    esac
  done

  local stream_url="${ADMIN_URL}/events/stream"
  local history_url="${ADMIN_URL}/events/history?all=true&limit=100000&eventTypes=provider:request_start,provider:request_end,provider:request_error,provider:rate_limited,provider:request_timeout,provider:request_aborted,macro-dialectic:triad-ready,macro-dialectic:triad-started,macro-dialectic:yang-complete,macro-dialectic:yin-complete,macro-dialectic:unity-complete,macro-dialectic:unity-failed"
  if [[ -n "$since_value" ]]; then
    history_url="${history_url}&since=${since_value}"
  fi

  echo "[llm events] LLM request stream" >&2
  if [[ -n "$since_value" ]]; then
    echo "  Replaying: events since ${since_value}" >&2
  fi
  echo "" >&2

  # Python inline processor — faster and more reliable than bash+jq per-line
  {
    if [[ -n "$since_value" ]]; then
      curl -sf "$history_url" 2>/dev/null | python3 -u -c "
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for evt in d.get('events', []):
    print('data: ' + json.dumps(evt, separators=(',', ':')))
"
    fi
    curl -sN --no-buffer "$stream_url" 2>/dev/null
  } | python3 -u -c "
import sys, json

json_mode = $( $json_mode && echo True || echo False )
compact_mode = $( $compact_mode && echo True || echo False )
text_filter = '${filter}'
source_filter = '${source_filter}'

# ANSI helpers
RST  = '\033[0m'
BOLD = '\033[1m'
DIM  = '\033[90m'
CYAN = '\033[36m'
GRN  = '\033[32m'
RED  = '\033[31m'
YEL  = '\033[33m'
MAG  = '\033[35m'

from datetime import datetime
import os, textwrap

def fmt_ts(value):
    try:
        return datetime.fromtimestamp(float(value) / 1000.0).strftime('%H:%M:%S.%f')[:12]
    except Exception:
        return '??:??:??.???'

for raw in sys.stdin:
    raw = raw.strip()
    if not raw.startswith('data: '):
        continue
    payload = raw[6:]
    if not payload or payload == '{}':
        continue
    try:
        d = json.loads(payload)
    except json.JSONDecodeError:
        continue

    etype = d.get('type', '')

    # Only show provider and macro-dialectic events
    if not (etype.startswith('provider:') or etype.startswith('macro-dialectic:')):
        continue

    if text_filter and text_filter not in payload:
        continue
    source = d.get('source', '')
    if source_filter and not str(source).startswith(source_filter):
        continue

    if json_mode:
        print(payload, flush=True)
        continue

    prov   = d.get('providerId', '?')
    model  = d.get('model', '?')
    pm     = f'{prov}/{model}'
    rid    = d.get('requestId', '')[-8:]
    sid    = d.get('sessionId', '')[-8:]
    dur    = d.get('durationMs', '')
    err    = d.get('error', '')
    tok    = d.get('tokensUsed', {})
    t      = fmt_ts(d.get('timestamp'))

    if etype == 'provider:request_start':
        msgs = d.get('messageCount', '?')
        print(f'{CYAN}{t}{RST}  {BOLD}-> START{RST}  {pm:<32}  {DIM}msgs={msgs}  session={sid}  req={rid}{RST}', flush=True)

    elif etype == 'provider:request_end':
        src = d.get('source', '')
        src_tag = f' {DIM}({src}){RST}' if src else ''
        if err and err != 'None':
            print(f'{RED}{t}{RST}  {BOLD}x  ERROR{RST}  {pm}{src_tag}  {dur}ms  {RED}{err}{RST}', flush=True)
        else:
            tin  = tok.get('input', 0)  if isinstance(tok, dict) else 0
            tout = tok.get('output', 0) if isinstance(tok, dict) else tok or 0
            tthk = tok.get('thinking',0) if isinstance(tok, dict) else 0
            tok_str = f'{tin}in/{tout}out'
            if tthk: tok_str += f'/{tthk}think'
            if compact_mode:
                print(f'{GRN}{t}{RST}  {BOLD}<- DONE {RST}  {pm}{src_tag}  {YEL}{dur}ms{RST}  {DIM}{tok_str}{RST}', flush=True)
            else:
                print(f'{GRN}{t}{RST}  {BOLD}<- DONE {RST}  {pm}{src_tag}  {YEL}{dur}ms{RST}  {DIM}{tok_str}  req={rid}{RST}', flush=True)

    elif etype == 'provider:request_error':
        print(f'{RED}{t}{RST}  {BOLD}x  FAIL {RST}  {pm:<32}  {dur}ms  {RED}{err}{RST}', flush=True)

    elif etype == 'provider:rate_limited':
        print(f'{YEL}{t}{RST}  {BOLD}!! LIMIT{RST}  {pm:<32}  rate limited', flush=True)

    elif etype == 'provider:request_timeout':
        tms = d.get('timeoutMs', '?')
        print(f'{YEL}{t}{RST}  {BOLD}~  T/OUT{RST}  {pm:<32}  after {tms}ms', flush=True)

    elif etype == 'provider:request_aborted':
        print(f'{DIM}{t}  x  ABORT  {pm:<32}  req={rid}{RST}', flush=True)

    elif etype.startswith('macro-dialectic:'):
        sub = etype.split(':', 1)[1]
        role = d.get('role', d.get('message', ''))
        extra = ''
        if 'durationMs' in d: extra += f' {d[\"durationMs\"]}ms'
        if 'reasoningChunks' in d: extra += f' chunks={d[\"reasoningChunks\"]}'
        if 'tokensGenerated' in d: extra += f' tokens={d[\"tokensGenerated\"]}'
        print(f'{MAG}{t}{RST}  {BOLD}@  TRIAD{RST}  {sub:<24}  {DIM}{role}{extra}{RST}', flush=True)
"
}

# ── llm stream — real-time LLM output/thinking stream ─────────────────────────

llm_stream() {
  local json_mode=false
  local provider_filter=""
  local source_filter=""
  local show_all=false
  local show_meta=false
  local show_prompt=false
  local history_count="0"
  local since_value=""
  local history_only=false
  local full_mode=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)     json_mode=true       ; shift ;;
      --provider) provider_filter="$2" ; shift 2 ;;
      --source)   source_filter="$2"   ; shift 2 ;;
      --all)      show_all=true        ; shift ;;
      --meta)     show_meta=true       ; shift ;;
      --prompt)   show_prompt=true     ; shift ;;
      --history)  history_count="$2"  ; shift 2 ;;
      --since)    since_value="$2"    ; shift 2 ;;
      --history-only) history_only=true ; shift ;;
      --full)     full_mode=true       ; shift ;;
      *)          shift ;;
    esac
  done

  local stream_url="${ADMIN_URL}/events/stream"
  local history_query="all=true&limit=100000&eventTypes=provider:request_start,provider:request_prompt,provider:request_chunk,provider:request_end,provider:request_error,macro-dialectic:triad-ready,macro-dialectic:triad-started,macro-dialectic:yang-complete,macro-dialectic:yin-complete,macro-dialectic:unity-stream-chunk,macro-dialectic:unity-complete,macro-dialectic:unity-failed"
  if [[ -n "$since_value" ]]; then
    history_query="${history_query}&since=${since_value}"
  else
    history_query="${history_query}&tail=${history_count}"
  fi
  local history_url="${ADMIN_URL}/events/history?${history_query}"

  echo "[llm stream] LLM output stream" >&2
  if [[ -n "$provider_filter" ]]; then
    echo "  Filtering: provider=$provider_filter" >&2
  fi
  if [[ -n "$since_value" ]]; then
    echo "  Replaying: events since ${since_value}" >&2
  elif [[ "$history_count" != "0" ]]; then
    echo "  Replaying: last ${history_count} matching events" >&2
  fi
  if [[ "$history_only" == true ]]; then
    echo "  Mode: history only" >&2
  fi
  if [[ "$full_mode" == true ]]; then
    echo "  View: full" >&2
  else
    echo "  View: compact" >&2
  fi
  echo "" >&2

  {
    if [[ "$history_count" != "0" || -n "$since_value" ]]; then
      curl -sf "$history_url" 2>/dev/null | python3 -u -c "
import sys, json

try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)

for evt in d.get('events', []):
    print('data: ' + json.dumps(evt, separators=(',', ':')))
"
    fi

    if [[ "$history_only" != true ]]; then
      curl -sN --no-buffer "$stream_url" 2>/dev/null || \
        echo 'data: {"type":"__curl_failed","code":'$?'}'
    fi
  } | python3 -u -c "
import sys, json, time, os, textwrap, math
from datetime import datetime
from collections import defaultdict

json_mode = $( $json_mode && echo True || echo False )
provider_filter = '${provider_filter}'
source_filter = '${source_filter}'
show_all = $( $show_all && echo True || echo False )
show_meta = $( $show_meta && echo True || echo False )
show_prompt = $( $show_prompt && echo True || echo False )
full_mode = $( $full_mode && echo True || echo False )
history_only = $( $history_only && echo True || echo False )

# ANSI codes
RST   = '\033[0m'
BOLD  = '\033[1m'
DIM   = '\033[38;5;245m'
CYAN  = '\033[36m'
GRN   = '\033[32m'
RED   = '\033[31m'
YEL   = '\033[33m'
MAG   = '\033[35m'
BLUE  = '\033[34m'
WHITE = '\033[38;5;252m'
ITAL  = '\033[3m'

# Unicode glyphs
U_DOT     = '\u25cf'        # filled circle
U_DOT_BIG = '\u25c9'        # fisheye (slow)
U_CHAIN   = '\u203a'        # single right angle quote
U_SECT    = '\u25b8'        # right-pointing small triangle
U_TREE_BR = '\u251c\u2500'  # tee + horizontal
U_TREE_LT = '\u2514\u2500'  # corner + horizontal
U_TREE_PI = '\u2502'        # vertical bar
U_BOX_TOP = '\u250c'        # top-left corner
U_BOX_MID = '\u251c'        # left tee
U_BOX_BOT = '\u2514'        # bottom-left corner
U_BOX_PI  = '\u2502'        # vertical bar
U_BULLET  = '\u25aa'        # small filled square
U_WARN    = '\u26a0'        # warning sign
U_CHECK   = '\u2713'        # check mark
U_CROSS   = '\u2717'        # ballot x
U_MDOT    = '\u00b7'        # middle dot
U_ELLIP   = '\u2026'        # horizontal ellipsis

LANE_COLORS = [CYAN, GRN, BLUE, YEL, '\033[91m', '\033[92m', '\033[93m']
color_idx = [0]

def next_color():
    c = LANE_COLORS[color_idx[0] % len(LANE_COLORS)]
    color_idx[0] += 1
    return c

# ── ANSI literal resolution ──────────────────────────────────────

def resolve_ansi_literals(text):
    esc = chr(27)
    bslash = chr(92)
    text = text.replace(bslash + '033[', esc + '[')
    text = text.replace(bslash + 'x1b[', esc + '[')
    text = text.replace(bslash + 'e[', esc + '[')
    return text

# ── Formatting helpers ───────────────────────────────────────────

def fmt_duration(ms):
    if ms is None or ms == '':
        return ''
    ms = int(ms)
    if ms < 1000:
        return str(ms) + 'ms'
    if ms < 60000:
        v = ms / 1000.0
        return ('{:.1f}s'.format(v)) if v < 10 else ('{:.0f}s'.format(v))
    mins = ms // 60000
    secs = (ms % 60000) / 1000.0
    return '{}m {:.0f}s'.format(mins, secs)

def fmt_count(n):
    if n is None or n == 0:
        return '0'
    n = int(n)
    if n < 1000:
        return str(n)
    if n < 10000:
        return '{:.1f}k'.format(n / 1000.0)
    return '{:.0f}k'.format(n / 1000.0)

def now_ts():
    return datetime.now().strftime('%H:%M:%S.%f')[:12]

def fmt_ts(value):
    try:
        return datetime.fromtimestamp(float(value) / 1000.0).strftime('%H:%M:%S.%f')[:12]
    except Exception:
        return now_ts()

TERM_WIDTH = max(72, min(140, int(os.environ.get('COLUMNS') or 100)))

def wrap_line(text, indent='    ', width=None):
    width = width or max(40, TERM_WIDTH - len(indent) - 2)
    wrapped = textwrap.wrap(text, width=width, replace_whitespace=False, drop_whitespace=False)
    return [(indent + line) for line in wrapped] or [indent]

def one_line_preview(text, limit=160):
    compact = ' '.join((text or '').strip().split())
    if not compact:
        return ''
    if len(compact) <= limit:
        return compact
    return compact[:limit - 1] + U_ELLIP

# ── Adaptive duration tracker ────────────────────────────────────

class DurationTracker:
    def __init__(self, window=50, default_p75=8000, default_p95=20000):
        self.window = window
        self.durations = []
        self.default_p75 = default_p75
        self.default_p95 = default_p95

    def add(self, ms):
        if ms is None:
            return
        self.durations.append(int(ms))
        if len(self.durations) > self.window:
            self.durations = self.durations[-self.window:]

    def percentile(self, p):
        if len(self.durations) < 5:
            return self.default_p75 if p <= 75 else self.default_p95
        s = sorted(self.durations)
        idx = int(len(s) * p / 100)
        return s[min(idx, len(s) - 1)]

    @property
    def p75(self):
        return self.percentile(75)

    @property
    def p95(self):
        return self.percentile(95)

dur_tracker = DurationTracker()

# ── Source / label helpers ───────────────────────────────────────

def normalize_source_filter(value):
    aliases = {
        'yang': 'lumen:yang',
        'yin': 'lumen:yin',
        'executive': 'lumen:executive',
        'lumen': 'lumen:',
        'macro-yang': 'macro-dialectic:yang',
        'macro-yin': 'macro-dialectic:yin',
        'unity': 'macro-dialectic:unity',
        'observer': 'subconscious:observer',
        'subconscious': 'subconscious:',
        'dialectic': 'dialectic:',
        'macro': 'macro-dialectic:',
    }
    return aliases.get(value, value)

source_filter = normalize_source_filter(source_filter)

def short_source(source):
    mapping = {
        'lumen:yang': 'yang',
        'lumen:yin': 'yin',
        'lumen:executive': 'exec',
        'macro-dialectic:yang': 'm:yang',
        'macro-dialectic:yin': 'm:yin',
        'macro-dialectic:unity': 'm:unity',
        'dialectic:yang': 'd:yang',
        'dialectic:yin': 'd:yin',
        'dialectic:serenity': 'd:serenity',
        'dialectic:consolidated': 'd:consol',
        'dialectic:parallel': 'd:parallel',
        'dialectic:guide': 'd:guide',
        'subconscious:observer': 'subcon',
        'thinker:ponder': 'thinker:ponder',
        'thinker:think': 'thinker:think',
        'session-pipeline': 'conversation',
        'turn-pipeline': 'conversation',
        'ai-scientist': 'scientist',
        'ai-engineer:prompt-evolver': 'engineer',
        'self-healer': 'healer',
    }
    return mapping.get(source, source)

# ── Lumen / FluxTeam context extraction ──────────────────────────

# Posture colors: Yang=yellow (assertive), Yin=cyan (cautious), Executive=magenta
POSTURE_COLORS = {
    'yang': YEL,
    'yin': CYAN,
    'executive': MAG,
    'exec': MAG,
}

POSTURE_ICONS = {
    'yang': '\u2607',    # lightning
    'yin': '\u2756',     # diamond
    'executive': '\u2605', # star
    'exec': '\u2605',
}

def extract_lumen_context(info):
    # Extract Lumen posture and FluxTeam info from source and sessionId.
    # Returns dict with posture, team_id, lumen_session
    ctx = {'posture': None, 'team_id': None, 'lumen_session': None}
    source = info.get('source', '') or ''
    session_id = info.get('sessionId', '') or ''

    # Extract posture from source field (set by LumenAgentSession)
    if source.startswith('lumen:'):
        ctx['posture'] = source.split(':')[1]

    # Fallback: extract posture from sessionId pattern
    # e.g. sess_lumen-1773796674025-yin
    if not ctx['posture'] and 'lumen-' in session_id:
        for p in ('yang', 'yin', 'executive'):
            if session_id.endswith('-' + p):
                ctx['posture'] = p
                break

    # Extract lumen session base id
    if 'lumen-' in session_id:
        # sess_lumen-1773796674025-yin -> lumen-1773796674025
        parts = session_id.replace('sess_', '').rsplit('-', 1)
        if len(parts) == 2 and parts[1] in ('yang', 'yin', 'executive'):
            ctx['lumen_session'] = parts[0]
        else:
            ctx['lumen_session'] = session_id.replace('sess_', '')

    return ctx

# ── Session cost tracking ────────────────────────────────────────

session_totals = {}  # lumen_session_id -> {input: N, output: N, thinking: N, requests: N}

def track_session_tokens(info, end_data):
    # Track running token totals per lumen session.
    lctx = extract_lumen_context(info)
    sid = lctx.get('lumen_session')
    if not sid or not end_data or not isinstance(end_data, dict):
        return
    tok = end_data.get('tokensUsed', {})
    if not isinstance(tok, dict):
        return
    if sid not in session_totals:
        session_totals[sid] = {'input': 0, 'output': 0, 'thinking': 0, 'requests': 0}
    session_totals[sid]['input'] += tok.get('input', 0)
    session_totals[sid]['output'] += tok.get('output', 0)
    session_totals[sid]['thinking'] += tok.get('thinking', 0)
    session_totals[sid]['requests'] += 1

def format_session_totals(lumen_session):
    # Format running session totals as a compact string.
    if not lumen_session or lumen_session not in session_totals:
        return ''
    t = session_totals[lumen_session]
    total = t['input'] + t['output'] + t['thinking']
    if total == 0:
        return ''
    return DIM + '[' + fmt_count(total) + '/' + str(t['requests']) + 'r]' + RST

def format_source_chain(info):
    trigger = info.get('trigger', '') or ''
    source = info.get('source', '') or ''

    # Resolve source — try the source field first, then sessionId fallback
    if not source or source == 'unknown':
        lctx = extract_lumen_context(info)
        if lctx['posture']:
            source = 'lumen:' + lctx['posture']

    source = short_source(source)
    if trigger:
        trigger = short_source(trigger)
        if trigger == source:
            return source
        return trigger + ' ' + U_CHAIN + ' ' + source
    return source

def short_label(info):
    prov = info.get('provider', '?')
    if prov.startswith('github-'):
        prov = 'gh'
    return prov + '/' + str(info.get('model', '?'))

