#!/usr/bin/env bash
# bin/cassi — launches the CassiCLI (Crush fork) binary.
#
# Build once with:   npm run build:cassi-cli
# Or from cassi-cli: cd cassi-cli && go build -o ../bin/cassi-bin .
#
# The compiled binary is stored at bin/cassi-bin.  If it doesn't exist yet
# this wrapper attempts to build it automatically.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BINARY="$SCRIPT_DIR/cassi-bin"
CASSI_CLI_DIR="$(dirname "$SCRIPT_DIR")/cassi-cli"

# Auto-build if the binary is missing.
if [[ ! -x "$BINARY" ]]; then
  echo "[cassi] Binary not found — building cassi-cli..." >&2
  if [[ ! -d "$CASSI_CLI_DIR" ]]; then
    echo "[cassi] ERROR: cassi-cli/ submodule not found at $CASSI_CLI_DIR" >&2
    echo "[cassi]        Run: git submodule update --init cassi-cli" >&2
    exit 1
  fi
  (cd "$CASSI_CLI_DIR" && go build -o "$BINARY" .) >&2
  echo "[cassi] Build complete." >&2
fi

# Ensure the daemon is running before launching.
CASSICORE_URL="${CASSICORE_URL:-http://localhost:7433}"

exec "$BINARY" "$@"
