#!/usr/bin/env node
/**
 * CassiCore Unified Launcher
 * 
 * Single command to manage CassiCore daemon and CLI/TUI.
 * 
 * Commands:
 *   cassicore daemon    - Start daemon
 *   cassicore cli       - Start CLI (auto-starts daemon if needed)
 *   cassicore tui       - Start TUI (auto-starts daemon if needed)
 *   cassicore status    - Check daemon status
 *   cassicore stop      - Stop daemon
 *   cassicore help      - Show help
 */

import { spawn, execSync } from 'child_process';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';
import { existsSync } from 'fs';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const rootDir = join(__dirname, '..');
const cliDir = join(rootDir, 'cli');

// Colors
const c = {
  reset: '\x1b[0m',
  bright: '\x1b[1m',
  dim: '\x1b[2m',
  red: '\x1b[31m',
  green: '\x1b[32m',
  yellow: '\x1b[33m',
  cyan: '\x1b[36m',
  magenta: '\x1b[35m',
};

function log(msg, color = 'reset') {
  console.log(`${c[color]}${msg}${c.reset}`);
}

const HELP = `
${c.cyan}🧠 CassiCore - AI Agent with Dialectic Reasoning${c.reset}

${c.bright}Usage:${c.reset}
  cassicore <command> [options]

${c.bright}Commands:${c.reset}
  ${c.cyan}daemon${c.reset}              Start CassiCore daemon
  ${c.cyan}cli${c.reset}      [options]  Start CLI mode (auto-starts daemon)
  ${c.cyan}tui${c.reset}      [options]  Start TUI mode (auto-starts daemon)
  ${c.cyan}status${c.reset}             Check daemon status
  ${c.cyan}stop${c.reset}               Stop daemon
  ${c.cyan}help${c.reset}               Show this help

${c.bright}Examples:${c.reset}
  cassicore daemon                      # Start daemon in background
  cassicore cli "Explain this code"     # Run CLI with prompt
  cassicore tui @files.ts "Fix bug"     # Start TUI with files
  cassicore status                      # Check if daemon is running

${c.bright}Environment:${c.reset}
  CASSICORE_URL        Daemon URL (default: http://localhost:7432)
  CASSICORE_TIMEOUT    Request timeout in ms (default: 5000)
  CASSICORE_USE_DAEMON Enable/disable daemon integration (default: true)

${c.dim}More info: https://github.com/cassicore/cassicore${c.reset}
`;

function checkDaemon() {
  for (const port of [7432, 7433, 7434]) {
    try {
      execSync(`curl -s --max-time 1 http://127.0.0.1:${port}/health`, { stdio: 'pipe' });
      return port;
    } catch {
      continue;
    }
  }
  return null;
}

function startDaemon() {
  return new Promise((resolve, reject) => {
    log('Starting CassiCore daemon...', 'cyan');

    const daemonPath = join(rootDir, 'dist', 'src', 'index.js');

    if (!existsSync(daemonPath)) {
      log('❌ Daemon not built', 'red');
      log('', 'reset');
      log('Build CassiCore first:', 'dim');
      log('  npm run build', 'cyan');
      reject(new Error('Daemon not built'));
      return;
    }

    const child = spawn('node', [daemonPath], {
      stdio: ['ignore', 'pipe', 'pipe'],
      detached: true,
      cwd: rootDir,
    });

    let output = '';
    let started = false;

    child.stdout?.on('data', (data) => {
      output += data.toString();
      
      // Look for JSON ready message
      if (!started) {
        try {
          const lines = output.trim().split('\n');
          const lastLine = lines[lines.length - 1];
          const json = JSON.parse(lastLine);
          
          if (json.status === 'started') {
            started = true;
            const port = json.admin?.tcpPort || 7432;
            log(`✅ Daemon started on port ${port}`, 'green');
            resolve(port);
          }
        } catch {
          // Not JSON yet, continue waiting
        }
      }
    });

    child.stderr?.on('data', (data) => {
      log(data.toString().trim(), 'red');
    });

    // Timeout after 10 seconds
    setTimeout(() => {
      if (!started) {
        log('❌ Daemon failed to start', 'red');
        if (output) {
          log('Output:', 'dim');
          log(output, 'yellow');
        }
        reject(new Error('Daemon startup timeout'));
      }
    }, 10000);

    child.on('error', (err) => {
      if (!started) {
        log(`❌ Daemon error: ${err.message}`, 'red');
        reject(err);
      }
    });

    child.on('exit', (code) => {
      if (!started && code !== 0) {
        log(`❌ Daemon exited with code ${code}`, 'red');
        reject(new Error(`Daemon exited with code ${code}`));
      }
    });
  });
}

function stopDaemon() {
  log('Stopping CassiCore daemon...', 'cyan');

  try {
    // Try graceful shutdown via API
    for (const port of [7432, 7433, 7434]) {
      try {
        execSync(`curl -s -X POST http://127.0.0.1:${port}/shutdown`, {
          stdio: 'pipe',
          timeout: 2000,
        });
        log('✅ Daemon stopped', 'green');
        return true;
      } catch {
        continue;
      }
    }

    // Fallback: kill by PID file
    const pidFile = join(rootDir, '.cassicore.pid');
    if (existsSync(pidFile)) {
      const pid = parseInt(execSync(`cat ${pidFile}`, { encoding: 'utf8' }).trim(), 10);
      if (pid > 0) {
        try {
          process.kill(pid, 'SIGTERM');
          log(`✅ Daemon (PID ${pid}) stopped`, 'green');
          return true;
        } catch {
          // Process already dead
        }
      }
    }

    log('ℹ️  Daemon was not running', 'yellow');
    return true;
  } catch (err) {
    log(`❌ Failed to stop daemon: ${err.message}`, 'red');
    return false;
  }
}

function showStatus() {
  const port = checkDaemon();

  if (port) {
    log('✅ CassiCore daemon is running', 'green');
    log(`   Port: ${port}`, 'dim');
    log(`   URL: http://127.0.0.1:${port}`, 'dim');

    try {
      const health = execSync(`curl -s http://127.0.0.1:${port}/health`, {
        encoding: 'utf8',
        timeout: 2000,
      });
      const data = JSON.parse(health);
      
      if (data.status) {
        log(`   Status: ${data.status}`, 'dim');
      }
      if (data.uptime) {
        const uptime = Math.floor(data.uptime / 1000);
        const mins = Math.floor(uptime / 60);
        const secs = uptime % 60;
        log(`   Uptime: ${mins}m ${secs}s`, 'dim');
      }
    } catch {
      // Health check failed, but port was open
    }
  } else {
    log('❌ CassiCore daemon is not running', 'red');
    log('', 'reset');
    log('Start the daemon:', 'dim');
    log('  cassicore daemon', 'cyan');
  }
}

function startCli(args) {
  const daemonPort = checkDaemon() || 7432;

  const cliPath = join(cliDir, 'dist', 'cli.js');

  if (!existsSync(cliPath)) {
    log('❌ CLI not built', 'red');
    log('', 'reset');
    log('Build the CLI:', 'dim');
    log('  cd cli && npm run build', 'cyan');
    process.exit(1);
  }

  const child = spawn('node', [cliPath, ...args], {
    stdio: 'inherit',
    cwd: process.cwd(),
    env: {
      ...process.env,
      CASSICORE_URL: `http://127.0.0.1:${daemonPort}`,
    },
  });

  child.on('exit', (code) => {
    process.exit(code || 0);
  });

  child.on('error', (err) => {
    log(`❌ CLI error: ${err.message}`, 'red');
    process.exit(1);
  });
}

function startTui(args) {
  const daemonPort = checkDaemon() || 7432;

  const cliPath = join(cliDir, 'dist', 'cli.js');

  if (!existsSync(cliPath)) {
    log('❌ TUI not built', 'red');
    log('', 'reset');
    log('Build the CLI:', 'dim');
    log('  cd cli && npm run build', 'cyan');
    process.exit(1);
  }

  // Add extension flag if not already present
  const hasExtension = args.some(a => a.startsWith('--extension') || a.startsWith('-e'));
  const extArgs = hasExtension ? args : [...args, '--extension', join(rootDir, 'cli', 'extensions', 'cassicore')];

  const child = spawn('node', [cliPath, ...extArgs], {
    stdio: 'inherit',
    cwd: process.cwd(),
    env: {
      ...process.env,
      CASSICORE_URL: `http://127.0.0.1:${daemonPort}`,
    },
  });

  child.on('exit', (code) => {
    process.exit(code || 0);
  });

  child.on('error', (err) => {
    log(`❌ TUI error: ${err.message}`, 'red');
    process.exit(1);
  });
}

// Main
async function main() {
  const args = process.argv.slice(2);
  const command = args[0]?.toLowerCase() || 'help';
  const commandArgs = args.slice(1);

  switch (command) {
    case 'daemon':
      try {
        await startDaemon();
      } catch {
        process.exit(1);
      }
      break;

    case 'cli':
      startCli(commandArgs);
      break;

    case 'tui':
      startTui(commandArgs);
      break;

    case 'status':
      showStatus();
      break;

    case 'stop':
      stopDaemon();
      break;

    case 'help':
    case '--help':
    case '-h':
      console.log(HELP);
      break;

    default:
      log(`❌ Unknown command: ${command}`, 'red');
      log('', 'reset');
      log('Use "cassicore help" for usage', 'dim');
      process.exit(1);
  }
}

main().catch((err) => {
  log(`❌ Error: ${err.message}`, 'red');
  process.exit(1);
});
