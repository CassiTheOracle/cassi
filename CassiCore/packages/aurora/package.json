{
  "name": "@cassicore/aurora",
  "version": "0.1.0",
  "description": "Aurora — cognitive state, self-model knowledge, claustrum, and subspace reasoning extracted from CassiCore. Explicitly-wired (not registry-discovered)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cassicore/constellation": "*",
    "@cassicore/foundation": "*",
    "@cassicore/mnemic-field": "*",
    "better-sqlite3": "^11.0.0"
  },
  "peerDependencies": {
    "cassi-larql": "*"
  },
  "peerDependenciesMeta": {
    "cassi-larql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
