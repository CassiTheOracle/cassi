{
  "name": "@cassicore/mind-runtime",
  "version": "0.1.0",
  "description": "The focused CassiCore mind runtime — the always-on cognitive process that owns MnemicField, the retained intelligence layer, orchestration loops, and a narrow 127.0.0.1 channel exposed to the ohmypi spine. Host-agnostic: depends on zero ohmypi / spine surface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "import": "./dist/boot.js"
    },
    "./channel/server": {
      "types": "./dist/channel/server.d.ts",
      "import": "./dist/channel/server.js"
    },
    "./channel/protocol": {
      "types": "./dist/channel/protocol.d.ts",
      "import": "./dist/channel/protocol.js"
    },
    "./memory/backend": {
      "types": "./dist/memory/backend.d.ts",
      "import": "./dist/memory/backend.js"
    }
  },
  "bin": {
    "cassi-mind": "./dist/run.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node ./dist/run.js"
  },
  "dependencies": {
    "@cassicore/aurora": "*",
    "@cassicore/constellation": "*",
    "@cassicore/cortex-pineal-dialectic": "*",
    "@cassicore/dreamer-reverie-subconscious": "*",
    "@cassicore/events": "*",
    "@cassicore/flux-team": "*",
    "@cassicore/foundation": "*",
    "@cassicore/helix": "*",
    "@cassicore/host": "*",
    "@cassicore/mini-helix": "*",
    "@cassicore/mnemic-field": "*",
    "@cassicore/model-pool": "*",
    "@cassicore/thalamus": "*",
    "@cassicore/tools": "*",
    "@cassicore/utils": "*",
    "@cassicore/workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
