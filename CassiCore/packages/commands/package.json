{
  "name": "@cassicore/commands",
  "version": "0.1.0",
  "description": "The CommandDispatcher (core/commands.ts) and the command-module family (commands/*) extracted from CassiCore. History-preserved import splice; depends on foundation, events, tools, and @cassicore/pipeline (IntelligenceLayer type); vendor-copies core/model-routing (ModelDirective) until a package owns it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "import": "./dist/commands/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cassicore/foundation": "*",
    "@cassicore/events": "*",
    "@cassicore/tools": "*",
    "@cassicore/pipeline": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
