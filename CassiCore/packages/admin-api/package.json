{
  "name": "@cassicore/admin-api",
  "version": "0.1.0",
  "description": "The CassiCore admin HTTP route registry + server mount (core/admin-api.ts createAdminApi) and the 54 route modules (core/admin-api/*). History-preserved import splice; the HTTP route contract (parts[0]-namespaced paths + method) is preserved verbatim. Depends on foundation, providers, plugins, jobs, mcp-gateway, and the landed brain-region packages; vendors host-coupled modules until @cassicore/host publishes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "import": "./dist/routes/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cassicore/foundation": "*",
    "@cassicore/plugins": "*",
    "@cassicore/jobs": "*",
    "@cassicore/mcp-gateway": "*",
    "@cassicore/commands": "*",
    "@cassicore/mnemic-field": "*",
    "@cassicore/cortex-pineal-dialectic": "*",
    "@cassicore/lamina-locus-bridge": "*",
    "@cassicore/dreamer-reverie-subconscious": "*",
    "@cassicore/helix": "*",
    "@cassicore/flux-team": "*",
    "@cassicore/embeddings": "*",
    "@cassicore/constellation": "*",
    "@cassicore/thalamus": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
