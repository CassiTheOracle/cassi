{
  "name": "@cassicore/constellation",
  "version": "0.1.0",
  "description": "Constellation multi-agent subsystem extracted from CassiCore. Standalone TypeScript ESM module; plugin-ready via src/ports.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:host-wired": "vitest run --config vitest.host-wired.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cassicore/aurora": "*",
    "@cassicore/cortex-pineal-dialectic": "*",
    "@cassicore/dreamer-reverie-subconscious": "*",
    "@cassicore/embeddings": "*",
    "@cassicore/foundation": "*",
    "@cassicore/helix": "*",
    "@cassicore/lamina-locus-bridge": "*",
    "@cassicore/mnemic-field": "*",
    "@cassicore/thalamus": "*",
    "@cassicore/tools": "*",
    "@cassicore/workspace": "*",
    "better-sqlite3": "^11.0.0",
    "uuid": "^9.0.0",
    "@cassicore/model-pool": "*",
    "@cassicore/workflow": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
