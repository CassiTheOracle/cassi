{
  "name": "@cassicore/claude-code-mcp",
  "version": "0.1.0",
  "description": "CassiCore MCP server for Claude Code — provides intelligence layer, context management, and multi-agent orchestration",
  "type": "module",
  "main": "src/server.ts",
  "bin": {
    "cassicore-mcp": "src/server.ts"
  },
  "scripts": {
    "start": "npx tsx src/server.ts",
    "start:proxy": "npx tsx src/proxy.ts",
    "start:hooks": "npx tsx src/hook-server.ts",
    "start:all": "npx tsx src/proxy.ts & npx tsx src/hook-server.ts &",
    "build": "tsc",
    "dev": "npx tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
