# CassiCore Claude Code Proxy — Provider Credentials
#
# Copy this file to .env and fill in your API keys.
# The proxy reads this file on startup to configure provider routing.
#
# After starting the proxy, it will auto-migrate ~/.claude/settings.json
# to remove hardcoded env vars and route all requests through localhost:7435.

# ── z.ai Provider (GLM models — default) ──────────────────────────────────────
# API key for z.ai (or the token from ~/.claude/settings.json ANTHROPIC_AUTH_TOKEN)
Z_AI_API_KEY=

# Base URL for z.ai (default: https://api.z.ai/api/anthropic)
# Z_AI_BASE_URL=https://api.z.ai/api/anthropic

# ── Anthropic Direct Provider (Claude models) ─────────────────────────────────
# API key for direct Anthropic API access (optional — z.ai handles all models if unset)
# ANTHROPIC_API_KEY=sk-ant-...

# Base URL for Anthropic direct (default: https://api.anthropic.com)
# ANTHROPIC_BASE_URL_DIRECT=https://api.anthropic.com

# ── DeepSeek Provider (V4 Flash/Pro) ──────────────────────────────────────────
# API key for DeepSeek V4 models (Anthropic-compatible endpoint)
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Base URL for DeepSeek Anthropic API (default: https://api.deepseek.com/anthropic)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# ── General Settings ──────────────────────────────────────────────────────────
# API timeout in milliseconds (default: 3000000 = 50 minutes)
# API_TIMEOUT_MS=3000000

# Proxy listen port (default: 7435)
# CASSICORE_PROXY_PORT=7435
