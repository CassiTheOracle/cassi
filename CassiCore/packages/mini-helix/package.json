{
  "name": "@cassicore/mini-helix",
  "version": "0.1.0",
  "description": "Mini-Helix lightweight single-posture agent sessions for Constellation infrastructure (Corpus, Brainstem), extracted from CassiCore. Standalone TypeScript ESM module; depends on @cassicore/foundation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:host-wired": "vitest run --config vitest.host-wired.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cassicore/foundation": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
