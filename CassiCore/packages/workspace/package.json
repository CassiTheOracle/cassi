{
  "name": "@cassicore/workspace",
  "version": "0.1.0",
  "description": "Global Workspace (GWT/blackboard) + radiance loop + code-analysis tooling extracted from CassiCore. GlobalWorkspace is the explicit-wired broadcast surface; code-analysis is batch git/schema tooling (sqlite). History-preserved import splice; depends on @cassicore/foundation and vendored runtime/type stubs pending later phases.",
  "type": "module",
  "main": "./dist/workspace/index.js",
  "types": "./dist/workspace/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./code-analysis": {
      "types": "./dist/code-analysis/index.d.ts",
      "import": "./dist/code-analysis/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cassicore/foundation": "*",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
