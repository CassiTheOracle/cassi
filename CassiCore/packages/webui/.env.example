# CassiCore WebUI Environment
# This file is for local development. Copy to .env.local and adjust as needed.

# URL of the CassiCore daemon Admin API (HTTP port)
# Default: http://localhost:7432
CASSICORE_API_URL=http://localhost:7432

# Default endpoint shown in the sidebar — points to this Next.js BFF
# so the UI talks to /api/* routes which proxy to CassiCore.
# Change to a remote URL for production deployments.
NEXT_PUBLIC_DEFAULT_ENDPOINT=http://localhost:3000
