{
  "nullable": [
    "detail_sha256"
  ],
  "optional": [],
  "props": {
    "code": {
      "enum": [
        "BAD_REQUEST",
        "AUTH_FAILED",
        "LENGTH_EXCEEDED",
        "SEQUENCE_MISMATCH",
        "IDENTITY_MISMATCH",
        "WORLD_EFFECT_INDETERMINATE",
        "INTERNAL"
      ],
      "type": "string"
    },
    "detail_sha256": {
      "one_of": [
        {
          "const": null
        },
        {
          "format": "sha256",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "error_sha256": {
      "format": "sha256",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "message_sha256": {
      "format": "sha256",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "related_kind": {
      "max_length": 256,
      "min_length": 1,
      "type": "string"
    },
    "related_schema": {
      "max_length": 256,
      "min_length": 1,
      "type": "string"
    },
    "request_id": {
      "max_length": 256,
      "min_length": 1,
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "schema": {
      "const": "cassi.qi-world-error.v1"
    },
    "terminal": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "code",
    "retryable",
    "terminal",
    "related_schema",
    "related_kind",
    "request_id",
    "message_sha256",
    "detail_sha256",
    "error_sha256"
  ]
}