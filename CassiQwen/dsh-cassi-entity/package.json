{
  "name": "@cassi/dsh-cassi-entity",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness host integration for the continuing Cassi entity",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./entity-client": "./entity-client.js",
    "./adapter": "./adapter.js",
    "./source-reader": "./source-reader.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-connection"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  }
}
