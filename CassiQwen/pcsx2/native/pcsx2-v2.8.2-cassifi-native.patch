+
+	bool BuildCurrentUserSecurity(PSECURITY_DESCRIPTOR* descriptor)
+	{
+		HANDLE token = nullptr;
+		if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+			return false;
+
+		DWORD required = 0;
+		GetTokenInformation(token, TokenUser, nullptr, 0, &required);
+		std::vector<std::uint8_t> token_user(required);
+		const bool token_ok = required != 0 && GetTokenInformation(token, TokenUser,
+			token_user.data(), required, &required);
+		CloseHandle(token);
+		if (!token_ok)
+			return false;
+
+		LPWSTR sid_string = nullptr;
+		const auto* user = reinterpret_cast<const TOKEN_USER*>(token_user.data());
+		if (!ConvertSidToStringSidW(user->User.Sid, &sid_string))
+			return false;
+
+		const std::wstring sddl = std::wstring(L"D:P(A;;GA;;;") + sid_string + L")";
+		LocalFree(sid_string);
+		return ConvertStringSecurityDescriptorToSecurityDescriptorW(
+			sddl.c_str(), SDDL_REVISION_1, descriptor, nullptr) != FALSE;
+	}
+
+	HANDLE CreatePipe(const wchar_t* name, DWORD access)
+	{
+		PSECURITY_DESCRIPTOR descriptor = nullptr;
+		if (!BuildCurrentUserSecurity(&descriptor))
+			return INVALID_HANDLE_VALUE;
+
+		SECURITY_ATTRIBUTES security = {};
+		security.nLength = sizeof(security);
+		security.lpSecurityDescriptor = descriptor;
+		HANDLE pipe = CreateNamedPipeW(name, access | FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE,
+			PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
+			1, kBaselinePayload, 4096, 0, &security);
+		LocalFree(descriptor);
+		return pipe;
+	}
+
+	bool IsStopping(HANDLE stop_event)
+	{
+		return WaitForSingleObject(stop_event, 0) == WAIT_OBJECT_0;
+	}
+
+	bool ConnectPipe(HANDLE pipe, HANDLE stop_event)
+	{
+		OVERLAPPED overlapped = {};
+		overlapped.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+		if (!overlapped.hEvent)
+			return false;
+
+		bool connected = false;
+		if (ConnectNamedPipe(pipe, &overlapped))
+		{
+			connected = true;
+		}
+		else
+		{
+			const DWORD error = GetLastError();
+			if (error == ERROR_PIPE_CONNECTED)
+				connected = true;
+			else if (error == ERROR_IO_PENDING)
+			{
+				HANDLE handles[] = {stop_event, overlapped.hEvent};
+				const DWORD wait_result = WaitForMultipleObjects(2, handles, FALSE, INFINITE);
+				if (wait_result == WAIT_OBJECT_0 + 1)
+				{
+					DWORD ignored = 0;
+					connected = GetOverlappedResult(pipe, &overlapped, &ignored, FALSE) != FALSE;
+				}
+				else
+				{
+					CancelIoEx(pipe, &overlapped);
+					WaitForSingleObject(overlapped.hEvent, INFINITE);
+					DWORD ignored = 0;
+					GetOverlappedResult(pipe, &overlapped, &ignored, FALSE);
+				}
+			}
+		}
+
+		CloseHandle(overlapped.hEvent);
+		return connected && !IsStopping(stop_event);
+	}
+
+	bool TransferExact(HANDLE pipe, HANDLE stop_event, void* data, DWORD size, bool writing)
+	{
+		auto* bytes = static_cast<std::uint8_t*>(data);
+		DWORD offset = 0;
+		DWORD stalls = 0;
+		while (offset < size)
+		{
+			if (IsStopping(stop_event))
+				return false;
+
+			OVERLAPPED overlapped = {};
+			overlapped.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+			if (!overlapped.hEvent)
+				return false;
+
+			DWORD transferred = 0;
+			const DWORD remaining = size - offset;
+			const BOOL immediate = writing ? WriteFile(pipe, bytes + offset, remaining, &transferred, &overlapped) :
+				ReadFile(pipe, bytes + offset, remaining, &transferred, &overlapped);
+			bool ok = immediate != FALSE;
+			bool stalled = false;
+			if (!ok && GetLastError() == ERROR_IO_PENDING)
+			{
+				HANDLE handles[] = {stop_event, overlapped.hEvent};
+				const DWORD wait_result = WaitForMultipleObjects(2, handles, FALSE, writing ? kTransferTimeoutMs : INFINITE);
+				if (wait_result == WAIT_OBJECT_0 + 1)
+				{
+					ok = GetOverlappedResult(pipe, &overlapped, &transferred, FALSE) != FALSE;
+				}
+				else
+				{
+					CancelIoEx(pipe, &overlapped);
+					WaitForSingleObject(overlapped.hEvent, INFINITE);
+					DWORD partial = 0;
+					GetOverlappedResult(pipe, &overlapped, &partial, FALSE);
+					transferred = partial;
+					stalled = true;
+				}
+			}
+			CloseHandle(overlapped.hEvent);
+			if (ok && transferred != 0)
+			{
+				offset += transferred;
+				stalls = 0;
+				continue;
+			}
+			// A reader busy between emulated frames stalls the write rather than
+			// leaving the pipe, so a stalled write retries the remaining bytes.
+			if (writing && stalled && !IsStopping(stop_event) && ++stalls <= kMaxWriteStalls)
+				continue;
+			return false;
+		}
+		return true;
+	}
+
+	bool SendFrame(HANDLE pipe, HANDLE stop_event, std::atomic<std::uint64_t>& sequence,
+		std::uint16_t type, const std::uint8_t* payload, std::uint32_t payload_size)
+	{
+		if (payload_size > kMaxPayload)
+			return false;
+		std::array<std::uint8_t, kHeaderSize> header = {};
+		std::memcpy(header.data(), "CASSIIPC", 8);
+		PutU16(header.data() + 8, 1);
+		PutU16(header.data() + 10, type);
+		PutU32(header.data() + 12, payload_size);
+		PutU64(header.data() + 16, sequence.fetch_add(1, std::memory_order_relaxed) + 1);
+		return TransferExact(pipe, stop_event, header.data(), static_cast<DWORD>(header.size()), true) &&
+			(payload_size == 0 || TransferExact(pipe, stop_event,
+				const_cast<std::uint8_t*>(payload), payload_size, true));
+	}
+
+	bool ReadFrame(HANDLE pipe, HANDLE stop_event, std::array<std::uint8_t, kHeaderSize>& header,
+		std::array<std::uint8_t, kMaxControlPayload>& payload, std::uint32_t* payload_size, std::uint64_t* sequence)
+	{
+		if (!TransferExact(pipe, stop_event, header.data(), static_cast<DWORD>(header.size()), false))
+			return false;
+		if (std::memcmp(header.data(), "CASSIIPC", 8) != 0 || GetU16(header.data() + 8) != 1)
+			return false;
+		const std::uint32_t size = GetU32(header.data() + 12);
+		if (size > payload.size())
+			return false;
+		if (size != 0 && !TransferExact(pipe, stop_event, payload.data(), size, false))
+			return false;
+		*payload_size = size;
+		*sequence = GetU64(header.data() + 16);
+		return true;
+	}
