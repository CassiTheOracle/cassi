@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-3.0+
+
+// Version 1 uses little-endian fields. Every frame starts with:
+//   magic[8] = "CASSIIPC", version:u16, type:u16, payload_bytes:u32, sequence:u64.
+// Stream types: SESSION=1 (72-byte fixed prefix then UTF-8 serial/title),
+// BASELINE_CHUNK=2 (snapshot:u64, frame:u64, ram_bytes:u32, offset:u32,
+// chunk_index:u16, chunk_count:u16, data_bytes:u32, data[]),
+// DELTA=3 (baseline:u64, frame:u64, page_count:u32, record_bytes:u32,
+// then page_index:u32 + 4096 bytes for each page), GAP=4 (first/last frame:u64,
+// reason:u32, reserved:u32), VM_RESET=5 (old/new stream id[16], generation:u64,
+// frame:u64, reason:u32, reserved:u32), INPUT_EVENT=6 (40 bytes),
+// ACTION_RECEIPT=7 (60 bytes).
+// Control types HELLO=0x100 (44 bytes), ENABLE=0x101 (IDs[48], expected_current_crc:u32
+// matching SESSION.current_crc at payload offset 64, serial_bytes:u16, reserved:u16, then
+// UTF-8 serial[1..256]), CANCEL=0x103 (48 bytes), ACTION=0x102 (56 bytes). Commands begin
+// with session_id[16], stream_id[16], request_id[16]; ACTION adds active-high DS2 buttons:u32,
+// frames:u16, reserved:u16. ACTION_RECEIPT result:u16 at 16: 0 completed, 1 cancelled, 2 rejected,
+// 3 gate enabled, 4 expired. reason:u16 at 18: 0 none, 1 gate disabled, 2 wrong game,
+// 3 not foreground, 4 physical override, 5 busy, 6 invalid mask, 7 invalid duration,
+// 8 unsupported pad, 9 unknown request, 10 client disconnected, 11 VM reset,
+// 12 control queue full, 13 action limit, 14 no SIO sample, 15 partial.
+// CANCEL uses the original ACTION request_id; duplicate requests replay the cached terminal receipt.
+
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+
+namespace NativeFieldBridge
+{
+	// Host-side memory pokes use this mutex so frame snapshots cannot race those
+	// external writes. Guest EE stores are serialized by the CPU-thread hook.
+	std::mutex& GetEEMemoryWriterMutex();
+
+	// Lifecycle notifications are synchronized; OnVMReset may run on the
+	// lifecycle caller thread only while EE execution is paused/quiescent.
+	// Frame and input hooks run synchronously on the emulation CPU thread.
+	void OnVMStarted();
+	void OnVMStopped();
+	void OnVMReset();
+	void OnFrameBoundary();
+	void OnGameIdentityChanged();
+	void OnInputPoll();
+
+	// DS2 overlay is a 16-bit active-high mask in PS2 wire button-bit order.
+	std::uint32_t GetVirtualButtonMask(std::uint8_t unified_slot, bool physical_input_active);
+
+	// Called once at the first button byte of each SIO poll command. Both button
+	// words are active-low; virtual_mask is the active-high subset actually used.
+	void OnPadSample(std::uint8_t unified_slot, bool physical_input_active,
+		std::uint32_t physical_active_low, std::uint32_t actual_active_low,
+		std::uint32_t virtual_mask, std::uint8_t lx, std::uint8_t ly,
+		std::uint8_t rx, std::uint8_t ry);
+} // namespace NativeFieldBridge
