+		std::atomic<std::uint64_t> m_frame_no{0};
+		std::atomic<std::uint64_t> m_next_snapshot_frame{0};
+		std::atomic<std::uint64_t> m_sample_no{0};
+
+		std::mutex m_controller_mutex;
+		std::array<ActionRecord, kReceiptLimit> m_receipts = {};
+		std::size_t m_receipt_count = 0;
+		std::size_t m_active_action = kNoAction;
+		std::uint64_t m_action_start_frame = 0;
+		std::chrono::steady_clock::time_point m_action_deadline = {};
+		std::chrono::steady_clock::time_point m_action_total_deadline = {};
+		bool m_action_gate_enabled = false;
+		bool m_expected_identity_valid = false;
+		std::uint32_t m_expected_current_crc = 0;
+		std::uint16_t m_expected_serial_size = 0;
+		std::array<char, kSerialMax> m_expected_serial = {};
+
+		std::mutex m_command_mutex;
+		std::array<ControlCommand, kCommandQueueSize> m_commands = {};
+		std::size_t m_command_head = 0;
+		std::size_t m_command_count = 0;
+
+		std::mutex m_output_mutex;
+		std::array<OutputMessage, kOutputQueueSize> m_outputs = {};
+		std::size_t m_output_head = 0;
+		std::size_t m_output_count = 0;
+		bool m_output_overflow = false;
+		std::uint64_t m_output_overflow_first = 0;
+		std::uint64_t m_output_overflow_last = 0;
+
+		std::mutex m_gap_mutex;
+		bool m_manual_gap_pending = false;
+		std::uint64_t m_manual_gap_first = 0;
+		std::uint64_t m_manual_gap_last = 0;
+		std::uint32_t m_manual_gap_reason = 0;
+
+		std::mutex m_wait_mutex;
+		std::condition_variable m_cv;
+
+#ifdef _WIN32
+		std::atomic_bool m_server_started{false};
+		HANDLE m_stop_event = nullptr;
+		std::mutex m_pipe_mutex;
+		std::atomic<HANDLE> m_stream_pipe{INVALID_HANDLE_VALUE};
+		std::atomic<HANDLE> m_control_pipe{INVALID_HANDLE_VALUE};
+		std::atomic<std::uint64_t> m_stream_sequence{0};
+		std::thread m_stream_thread;
+		std::thread m_control_thread;
+#endif
+	};
+
